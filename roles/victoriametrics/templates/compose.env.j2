VICTORIAMETRICS_ALERTMANAGER_PASSWORD={{ victoriametrics_alertmanager_password | to_json(ensure_ascii=False) | replace('$', '$$') }}
{% if victoriametrics_vmauth_users | length > 0 %}
{% for password in victoriametrics_vmauth_passwords | dict2items %}
VICTORIAMETRICS_VMAUTH_{{ password.key }}={{ password.value | to_json(ensure_ascii=False) | replace('$', '$$') }}
{% endfor %}
{% endif %}

VICTORIALOGS_REMOTEWRITE_PASSWORD={{ victorialogs_victoriametrics_remotewrite_password | to_json(ensure_ascii=False) | replace('$', '$$') }}
VICTORIALOGS_REMOTEREAD_PASSWORD={{ victorialogs_victoriametrics_remoteread_password | to_json(ensure_ascii=False) | replace('$', '$$') }}
VICTORIALOGS_ALERTMANAGER_PASSWORD={{ victorialogs_alertmanager_password | to_json(ensure_ascii=False) | replace('$', '$$') }}
{% if victorialogs_vmauth_users | length > 0 %}
{% for password in victorialogs_vmauth_passwords | dict2items %}
VICTORIALOGS_VMAUTH_{{ password.key }}={{ password.value | to_json(ensure_ascii=False) | replace('$', '$$') }}
{% endfor %}
{% endif %}

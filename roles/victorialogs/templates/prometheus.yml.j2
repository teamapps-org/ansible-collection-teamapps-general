global:
  scrape_interval: {{ victorialogs_scrape_interval }}
  scrape_timeout: {{ victorialogs_scrape_timeout }}
  external_labels:
    scraper_instance: {{ victorialogs_metrics_instance_label }} # deprecated, kept during collector_instance transition
    collector_instance: {{ victorialogs_metrics_instance_label }}
    # No global `host` external_label here (FND-1778): every self-scrape job below sets `host`
    # per-target, and user scrape_configs / scrape_config_files may relabel `host` to a probe
    # target. A global host would clobber per-target values without adding anything.

scrape_config_files:
  - /etc/prometheus/scrape_configs/*.yml

scrape_configs:
  - job_name: 'vmagent'
    metrics_path: /vmagent/metrics
    static_configs:
      - targets: ['vmagent:8429']
        labels:
          instance: {{ victorialogs_metrics_instance_label }}
          host: '{{ ansible_facts.hostname }}'

  - job_name: 'victorialogs'
    static_configs:
      - targets: ['victorialogs:9428']
        labels:
          instance: {{ victorialogs_metrics_instance_label }}
          host: '{{ ansible_facts.hostname }}'

  - job_name: 'vmalert'
    metrics_path: /vmalert/metrics
    static_configs:
      - targets: ['vmalert:8880']
        labels:
          instance: {{ victorialogs_metrics_instance_label }}
          host: '{{ ansible_facts.hostname }}'

{% if victorialogs_scrape_configs != [] %}
  {{ victorialogs_scrape_configs | teamapps.general.to_nice_yaml(indent=2) | indent(2,False) }}
{% endif %}

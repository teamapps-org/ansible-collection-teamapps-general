# {{ ansible_managed }}
groups:
  # Count missing minute buckets only in settled, overlapping sequence windows.
  # This collapses duplicate lines and tolerates isolated restart gaps.
  - name: victorialogs_canary_loss
    type: vlogs
    interval: 5m
    eval_delay: 5m
    rules:
      - record: log_canary_missing_minutes
        labels:
          domain: '{{ victorialogs_domain }}'
        expr: >-
          _time:10m {{ victorialogs_canary_stream_selector }}
          _msg:~"^(\\x{200B})?VLCANARY src=(journal|docker) seq=[0-9]+$"
          | extract "src=<src> seq=<seq>"
          | math floor((seq + 0) / 60) as seq_minute
          | stats by (host, src) min(seq_minute) as first_minute,
          max(seq_minute) as last_minute,
          count_uniq(seq_minute) as received_minutes
          | math (last_minute - first_minute + 1 - received_minutes)
          as log_canary_missing_minutes
          | fields host, src, log_canary_missing_minutes

  # Disable alignment because aligned requests skew LogsQL now(). The delay
  # avoids the open interval edge; source clock skew still appears as lag.
  - name: victorialogs_canary_lag
    type: vlogs
    interval: 1m
    eval_alignment: false
    eval_delay: 5s
    rules:
      - record: log_canary_lag_seconds
        labels:
          domain: '{{ victorialogs_domain }}'
        expr: >-
          _time:10m {{ victorialogs_canary_stream_selector }}
          _msg:~"^(\\x{200B})?VLCANARY src=(journal|docker) seq=[0-9]+$"
          | extract "src=<src> seq=<seq>"
          | math (now() - _time) as lag
          | stats by (host, src) min(lag) as lag_ns
          | math (lag_ns / 1000000000) as log_canary_lag_seconds
          | fields host, src, log_canary_lag_seconds

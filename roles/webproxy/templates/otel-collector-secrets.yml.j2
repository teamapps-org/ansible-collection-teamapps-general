{% if webproxy_victoriametrics_remotewrite_username | default('', true) | length > 0 %}
extensions:
  basicauth/remotewrite:
    client_auth:
      username: {{ webproxy_victoriametrics_remotewrite_username | replace('$', '$$') | to_json }}
      password: {{ webproxy_victoriametrics_remotewrite_password | replace('$', '$$') | to_json }}

{% endif %}
exporters:
  otlphttp:
    headers:
{% set trace_headers = {'Authorization': 'Basic ' ~ ((webproxy_otel_tracing_http_user ~ ':' ~ webproxy_otel_tracing_http_password) | b64encode)} | combine(webproxy_otel_tracing_http_headers) %}
{% for key, value in trace_headers.items() %}
      {{ key | to_json }}: {{ value | replace('$', '$$') | to_json }}
{% endfor %}
